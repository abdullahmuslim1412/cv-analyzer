# Rename this file to secrets.toml (and keep it OUT of version control / .gitignore it).
# Locally: put it in .streamlit/secrets.toml next to app.py
# On Streamlit Community Cloud: paste these into the app's "Secrets" settings panel.

OPENROUTER_API_KEY = "sk-or-v1-your-key-here"

# Optional: pre-select a default model (must match one of MODEL_OPTIONS in app.py)
OPENROUTER_MODEL = "openai/gpt-4o-mini"
